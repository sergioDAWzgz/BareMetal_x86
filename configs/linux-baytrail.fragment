# Linux configuration for the Jetway JNF3A payload.
#
# build.sh applies this on top of defconfig with scripts/kconfig/merge_config.sh,
# so only the decisions that differ from a generic x86_64 kernel live here. The
# result is auditable: a reader sees every deviation without diffing a 5000 line
# .config against a version they do not have.

# The payload boots headless and every phase 5 gate assertion is read from COM1.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_EARLY_PRINTK=y

# The loader hands over a compressed initramfs in a contiguous frame run.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# What the initramfs mounts. Without these /init has no /dev, no /proc and no
# /sys, and the drivers it wants to inspect are invisible to it.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Storage. The board has one SATA II port behind AHCI; QEMU's pc machine also
# exposes a PIIX controller, which is where the BIOS path keeps its boot disk.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_SD=y

# Gen7 graphics. i915 is the reason this payload exists at all.
CONFIG_DRM=y
CONFIG_DRM_I915=y

# One self-contained image: everything the board needs is built in, so there is no
# module loader and no module signing.
# CONFIG_MODULES is not set

# Deterministic placement. The loader loads the image at the address its own
# header asks for and the gate asserts the address it reported; a randomised
# base would move the kernel behind the loader's back.
# CONFIG_RANDOMIZE_BASE is not set
CONFIG_RELOCATABLE=y

# tools/objtool is mandatory on x86_64 in 6.12: arch/x86 selects HAVE_OBJTOOL
# whenever X86_64, and HAVE_UACCESS_VALIDATION selects OBJTOOL unconditionally.
# No unwinder or mitigation choice avoids it, so the host needs libelf headers
# (libelf-dev). That is why nothing here tries to dodge objtool any more, and why
# the unwinder and the speculation mitigations are left at their defaults: a
# payload built like an ordinary kernel is the point.

# The board's own console. i915 modesets the panel and fbcon paints the virtual
# terminals on it, so a monitor plus a USB keyboard and mouse are enough to use
# the system without opening COM1. linuxboot.c still lists ttyS0 last, so
# /dev/console and the gate keep reading the serial line.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# A UEFI-only machine without a DRM driver still needs a console: efifb paints
# the firmware's GOP framebuffer, so the installer ISO shows its TUI before (and
# without) i915. QEMU's stdvga has no i915 either; bochs-drm gives the emulated
# disks a screen, which is what lets the gate's QEMU runs show the console and
# the shutdown output without the board.
CONFIG_FB_EFI=y
CONFIG_DRM_BOCHS=y

# Input for that console. defconfig already builds the USB stack in (modules are
# off), but the local console depends on these, so the dependency is pinned here
# instead of resting on a default that a defconfig bump could drop. evdev feeds
# applications; mousedev is /dev/input/mice, which gpm reads.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO_I8042=y
CONFIG_MOUSE_PS2=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# Networking. The board's two NICs are the RTL8111H on PCI, driven by r8169; the
# gate emulates e1000s and asserts that both interfaces exist, so both drivers
# are pinned instead of depending on defconfig. NET/INET come from defconfig.
# r8169 asks for rtl8168h-2.fw from rtl_open, when the interface comes up, so the
# patch file can load after the root is mounted; Alpine ships it zstd-compressed.
CONFIG_R8169=y
CONFIG_E1000=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
