#!/bin/sh
# Installer initramfs init. Finds the ISO by label, mounts it and starts the TUI
# on the local console. Progress markers go to /dev/console (COM1).
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
echo "BMX-INSTALLER: init running" > /dev/console

# Spanish console by default; the TUI can change it.
if [ -f /usr/share/bkeymaps/es/es.bmap.gz ]; then
    zcat /usr/share/bkeymaps/es/es.bmap.gz | loadkmap
fi

iso=
iso_type=
tries=0
while [ "$tries" -lt 30 ]; do
    for dev in /dev/sr* /dev/sd* /dev/vd*; do
        [ -b "$dev" ] || continue
        info=$(blkid "$dev" 2>/dev/null)
        case "$info" in
        *BMXINSTALL*)
            iso=$dev
            iso_type=$(printf '%s\n' "$info" | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p')
            break
            ;;
        esac
    done
    [ -n "$iso" ] && break
    sleep 1
    tries=$((tries + 1))
done
if [ -z "$iso" ]; then
    echo "BMX-INSTALLER: ISO BMXINSTALL not found after 30 s" > /dev/console
    exec /bin/sh
fi
ISO_DISK=$(basename "$iso" | sed 's/[0-9]*$//')
export ISO_DISK
mkdir -p /media
# Rufus in ISO mode extracts the ISO tree to a FAT32 stick with the same label;
# a raw write leaves an ISO9660 filesystem. Mount whichever blkid reported.
case "$iso_type" in
vfat | fat | msdos) mount -t vfat -o ro "$iso" /media ;;
*) mount -t iso9660 -o ro "$iso" /media ;;
esac || {
    echo "BMX-INSTALLER: cannot mount $iso ($iso_type)" > /dev/console
    exec /bin/sh
}
echo "BMX-INSTALLER: ISO $iso ($iso_type) mounted as /dev/$ISO_DISK" > /dev/console

export TERM=linux
exec </dev/tty0 >/dev/tty0 2>&1
/bin/sh /installer/tui.sh
echo "BMX-INSTALLER: TUI exited" > /dev/console
exec /bin/sh
