#!/bin/sh
# Installer initramfs init. Finds the ISO by label, mounts it and starts the TUI
# on the local console. Progress markers go to /dev/console (COM1).
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
echo "BMX-INSTALLER: init running" > /dev/console

# Spanish console by default; the TUI can change it.
if [ -f /usr/share/bkeymaps/es/es.bmap.gz ]; then
    zcat /usr/share/bkeymaps/es/es.bmap.gz | loadkmap
fi

iso=
for dev in /dev/sr* /dev/sd* /dev/vd*; do
    [ -b "$dev" ] || continue
    if blkid "$dev" 2>/dev/null | grep -q BMXINSTALL; then
        iso=$dev
        break
    fi
done
if [ -z "$iso" ]; then
    echo "BMX-INSTALLER: ISO BMXINSTALL not found" > /dev/console
    exec /bin/sh
fi
ISO_DISK=$(basename "$iso" | sed 's/[0-9]*$//')
export ISO_DISK
mkdir -p /media
if ! mount -t iso9660 -o ro "$iso" /media; then
    echo "BMX-INSTALLER: cannot mount $iso" > /dev/console
    exec /bin/sh
fi
echo "BMX-INSTALLER: ISO $iso mounted as /dev/$ISO_DISK" > /dev/console

export TERM=linux
exec </dev/tty0 >/dev/tty0 2>&1
exec /bin/sh /installer/tui.sh
